# Copy to .env in this directory and fill in real values before running
# `docker compose --env-file .env up -d --build`. Never commit the real .env.

# The domain this Droplet serves the app on.
DOMAIN=deals.transformbiz.com.au

# Connection string for the syd1 Managed Postgres `deal_sourcing` database
# (see deploy/digitalocean/README.md step 3, in this repo). Falls back to a
# local SQLite file if left unset, which does NOT survive a redeploy — set
# this for anything beyond a quick local test.
DATABASE_URL=postgresql://deal_sourcing_app:PASSWORD@HOST:25060/deal_sourcing?sslmode=require
